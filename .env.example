# ─── Database ───────────────────────────────────────────────
# Local (docker-compose):
#   DATABASE_URL="postgresql://neondash:neondash@localhost:5432/neondash?schema=public"
# Railway: automatically injected when you attach a Postgres plugin.
DATABASE_URL="postgresql://neondash:neondash@localhost:5432/neondash?schema=public"

# ─── Auth ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Optional: seed an admin account on first boot
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@neondash.local"
ADMIN_PASSWORD="changeme-admin"
